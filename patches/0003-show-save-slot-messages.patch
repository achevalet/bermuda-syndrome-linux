+void Game::showMessage(const char *fmt, ...) {
+	va_list va;
+	va_start(va, fmt);
+	vsnprintf(_messageText, sizeof(_messageText), fmt, va);
+	va_end(va);
+	_messageEndTime = _stub->getTimeStamp() + 2500;
+}
+
+static uint8_t findPaletteColor(const uint8_t *pal, int r, int g, int b) {
+	uint8_t best = 0;
+	int bestSum = -1;
+	for (int i = 0; i < 256; ++i, pal += 4) {
+		const int dr = r - pal[2];
+		const int dg = g - pal[1];
+		const int db = b - pal[0];
+		const int sum = dr * dr + dg * dg + db * db;
+		if (bestSum == -1 || sum < bestSum) {
+			bestSum = sum;
+			best = i;
+		}
+	}
+	return best;
+}
+
+// Draws the message in the top right corner (the bag icon is often top left), white with a black shadow, in
+// the dialogue font. The screen buffer is stored bottom-up.
+void Game::drawMessage() {
+	if (!_messageText[0] || (int32_t)(_stub->getTimeStamp() - _messageEndTime) >= 0) {
+		_messageText[0] = 0;
+		return;
+	}
+	const uint8_t *pal = _bitmapBuffer0 + kOffsetBitmapPalette;
+	const uint8_t colors[2] = { findPaletteColor(pal, 0, 0, 0), findPaletteColor(pal, 255, 255, 255) };
+	int w = 0;
+	for (const char *p = _messageText; *p; ++p) {
+		w += _fontCharWidth[(uint8_t)*p] + 1;
+	}
+	for (int pass = 0; pass < 2; ++pass) {
+		int x = _bitmapBuffer1.w - 10 - w + 1 - pass;
+		const int y = 8 + 1 - pass;
+		for (const char *p = _messageText; *p; ++p) {
+			const int chr = (uint8_t)*p;
+			for (int i = 0; i < 16; ++i) {
+				const uint16_t bits = _fontData[chr * 16 + i];
+				for (int b = 0; b < 16; ++b) {
+					if ((bits & (1 << b)) && x + b >= 0 && x + b <= _bitmapBuffer1.w) {
+						_bitmapBuffer1.bits[(_bitmapBuffer1.h - y - i) * _bitmapBuffer1.pitch + x + b] = colors[pass];
+					}
+				}
+			}
+			x += _fontCharWidth[chr] + 1;
+		}
+	}
+}
