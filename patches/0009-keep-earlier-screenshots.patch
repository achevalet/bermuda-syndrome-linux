Keep earlier screenshots, and write the last pixel.

Screenshots (C key) were numbered from screenshot-001.tga in every
session, so the first ones of a new session replaced the previous
session's. Skip the names already taken.

The TGA writer also dropped the last run of pixels when it was a single
pixel, leaving the file one pixel short; ImageMagick then refuses it
("unable to read image data"). Always write the last run.

--- a/screenshot.cpp
+++ b/screenshot.cpp
@@ -59,12 +59,10 @@
 				count = 0;
 				prevColor = color;
 			}
-			if (count != 0) {
-				f.writeByte(count | 0x80);
-				f.writeByte((prevColor >> 16) & 255);
-				f.writeByte((prevColor >>  8) & 255);
-				f.writeByte( prevColor        & 255);
-			}
+			f.writeByte(count | 0x80);
+			f.writeByte((prevColor >> 16) & 255);
+			f.writeByte((prevColor >>  8) & 255);
+			f.writeByte( prevColor        & 255);
 		}
 	}
 }
--- a/systemstub_sdl.cpp
