+// Makes the newest save the current slot, so that L resumes the last game.
+void Game::selectLatestSaveSlot() {
+	DIR *dir = opendir(_savePath);
+	if (!dir) {
+		return;
+	}
+	int latestSlot = 0;
+	struct timespec latestTime = { 0, 0 };
+	while (struct dirent *de = readdir(dir)) {
+		const char *name = de->d_name;
+		if (strncmp(name, "bermuda.", 8) != 0 || !isdigit(name[8]) || !isdigit(name[9]) || !isdigit(name[10]) || name[11]) {
+			continue;
+		}
+		const int slot = atoi(name + 8);
+		char filePath[MAXPATHLEN];
+		snprintf(filePath, sizeof(filePath), kGameStateFileNameFormat, _savePath, slot);
+		struct stat st;
+		if (slot < 1 || stat(filePath, &st) != 0 || !S_ISREG(st.st_mode)) {
+			continue;
+		}
+		// Nanoseconds, so that saves made in the same second still compare.
+		const struct timespec &t = st.st_mtim;
+		if (latestSlot == 0 || t.tv_sec > latestTime.tv_sec || (t.tv_sec == latestTime.tv_sec && t.tv_nsec > latestTime.tv_nsec)) {
+			latestSlot = slot;
+			latestTime = t;
+		}
+	}
+	closedir(dir);
+	if (latestSlot != 0) {
+		_stateSlot = latestSlot;
+		debug(DBG_INFO, "Current game state slot is %d (the latest save)", _stateSlot);
+	}
+}
+
+// Returns the lowest slot without a save, or 0 if all are taken.
+int Game::findFreeSaveSlot() const {
+	for (int slot = 1; slot <= 999; ++slot) {
+		char filePath[MAXPATHLEN];
+		snprintf(filePath, sizeof(filePath), kGameStateFileNameFormat, _savePath, slot);
+		if (access(filePath, F_OK) != 0) {
+			return slot;
+		}
+	}
+	return 0;
+}
