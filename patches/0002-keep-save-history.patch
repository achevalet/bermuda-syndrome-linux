+static int isBackupName(const struct dirent *de) {
+	return de->d_name[0] != '.';
+}
+
+// Moves the save about to be overwritten to <backupPath>/bermuda.NNN/<date it
+// was saved>, then deletes all but the newest _backupCount files there.
+void Game::backupState(const char *filePath, int slot) {
+	struct stat st;
+	if (!_backupPath || _backupCount <= 0 || stat(filePath, &st) != 0) {
+		return;
+	}
+	char dirPath[MAXPATHLEN];
+	snprintf(dirPath, sizeof(dirPath), "%s/bermuda.%03d", _backupPath, slot);
+	mkdir(_backupPath, 0700);
+	mkdir(dirPath, 0700);
+	char date[32];
+	strftime(date, sizeof(date), "%Y-%m-%d_%H%M%S", localtime(&st.st_mtime));
+	char backupPath[MAXPATHLEN + 260]; // room for dirPath + a file name
+	snprintf(backupPath, sizeof(backupPath), "%s/%s", dirPath, date);
+	if (rename(filePath, backupPath) != 0) {
+		warning("Unable to back up '%s' to '%s'", filePath, backupPath);
+		return;
+	}
+	// Dates sort oldest first.
+	struct dirent **names;
+	const int count = scandir(dirPath, &names, isBackupName, alphasort);
+	for (int i = 0; i < count; ++i) {
+		if (i < count - _backupCount) {
+			snprintf(backupPath, sizeof(backupPath), "%s/%s", dirPath, names[i]->d_name);
+			unlink(backupPath);
+		}
+		free(names[i]);
+	}
+	if (count >= 0) {
+		free(names);
+	}
+}
